# Docker images. The workflow overrides these values during automatic deploy.
FRONTEND_IMAGE=ghcr.io/YOUR_GITHUB_OWNER/cinema-booking-frontend
BACKEND_IMAGE=ghcr.io/YOUR_GITHUB_OWNER/cinema-booking-backend
IMAGE_TAG=REPLACE_WITH_A_COMMIT_SHA
FRONTEND_HOST_PORT=3000

# MySQL. Generate unique random passwords; never reuse exposed credentials.
MYSQL_DATABASE=cinemabooking
MYSQL_USER=cinemabooking
MYSQL_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_ANOTHER_LONG_RANDOM_PASSWORD

# Redis is private to the Docker network but still requires authentication.
REDIS_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

# JWT HMAC-SHA256 secret: use at least 32 random bytes (64+ hex characters).
JWT_SECRET=REPLACE_WITH_AT_LEAST_64_RANDOM_HEX_CHARACTERS

# External services.
CLOUDINARY_CLOUD_NAME=REPLACE_ME
CLOUDINARY_API_KEY=REPLACE_ME
CLOUDINARY_API_SECRET=REPLACE_ME
MAIL_USERNAME=REPLACE_ME@gmail.com
MAIL_APP_PASSWORD=REPLACE_WITH_A_NEW_GMAIL_APP_PASSWORD
PAYOS_CLIENT_ID=REPLACE_ME
PAYOS_API_KEY=REPLACE_ME
PAYOS_CHECKSUM_KEY=REPLACE_ME

# Replace YOUR_DOMAIN only after DNS has been configured.
FRONTEND_URL=https://YOUR_DOMAIN
CORS_ALLOWED_ORIGINS=https://YOUR_DOMAIN
APP_TIME_ZONE=Asia/Ho_Chi_Minh

# Existing application tuning defaults.
CHAT_OUTBOX_RELAY_DELAY_MS=200
CHAT_OUTBOX_RELAY_INITIAL_DELAY_MS=500
CHAT_PRESENCE_REFRESH_MS=10000
CHAT_PRESENCE_TTL_SECONDS=30
BOOKING_SEAT_LOCK_TTL_MINUTES=1
BOOKING_EXPIRATION_RECONCILIATION_DELAY_MS=30000
BOOKING_EXPIRATION_RECONCILIATION_INITIAL_DELAY_MS=10000
PASSWORD_RESET_OTP_EXPIRATION_MINUTES=5
PASSWORD_RESET_RESEND_DELAY_SECONDS=60
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=CinemaBooking/1.0-ops@YOUR_DOMAIN

# Backup settings used by scripts/backup-mysql.sh.
BACKUP_DIR=/opt/project-book_movie_tickets/backups
BACKUP_RETENTION_DAYS=14
